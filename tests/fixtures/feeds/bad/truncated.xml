					<comments>https://www.omgubuntu.co.uk/2026/10/bleachbit-606-update-speed-boost#disqus_thread</comments>
		
		<dc:creator><![CDATA[Joey Sneddon]]></dc:creator>
		<pubDate>Mon, 19 Oct 2026 23:57:44 +0000</pubDate>
